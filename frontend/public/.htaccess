# Hotel SaaS on shared hosting: React app served from here, Laravel API under /api
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to PHP (Sanctum bearer tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # API -> Laravel
    RewriteRule ^api(/.*)?$ index.php [L]

    # Real files (assets, uploaded images, sw.js, manifest) are served as-is
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else -> React router
    RewriteRule ^ index.html [L]
</IfModule>

# Never expose dotfiles
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Smaller downloads on slow connections
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Built files have a content hash in their name: cache for a year. Uploaded pictures get a random name: 30 days.
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/storage/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Service worker must always be revalidated so app updates reach users
    <FilesMatch "^(sw\.js|registerSW\.js|index\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
